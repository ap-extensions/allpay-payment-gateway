msgid "Credit card payment via Allpay"
msgstr "תשלום בכרטיס אשראי באמצעות Allpay"

#: classes/class-allpay.php:27
#: classes/class-allpay.php:29
msgid "Allpay payment gateway plug-in for WooCommerce"
msgstr "תוסף שער התשלומים Allpay ל־WooCommerce"

#: classes/class-allpay.php:93
msgid "Enable / Disable"
msgstr "הפעלה / השבתה"

