msgid "Enable this payment gateway"
msgstr "הפעלת שער תשלומים זה"

#: classes/class-allpay.php:99
msgid "Title"
msgstr "כותרת"

#: classes/class-allpay.php:101
msgid "Payment method name shown to customers at checkout"
msgstr "שם אמצעי התשלום המוצג ללקוחות בעמוד התשלום"

#: classes/class-allpay.php:102
msgid "Recommended: Credit card payment via Allpay"
msgstr "מומלץ: תשלום בכרטיס אשראי באמצעות Allpay"

#: classes/class-allpay.php:106
msgid "Description"
msgstr "תיאור"

#: classes/class-allpay.php:108
msgid "Payment method description shown to customers at checkout"
msgstr "תיאור אמצעי התשלום המוצג ללקוחות בעמוד התשלום"

#: classes/class-allpay.php:109
msgid "Recommended: Pay securely with a credit/debit card, Apple Pay, or Bit"
msgstr "מומלץ: תשלום מאובטח בכרטיס אשראי/דביט, Apple Pay או Bit"

#: classes/class-allpay.php:110
msgid "Pay securely with a credit/debit card, Apple Pay, or Bit."
msgstr "שלם בצורה מאובטחת באמצעות כרטיס אשראי/דביט, Apple Pay או Bit."

#: classes/class-allpay.php:114
msgid "API login"
msgstr "שם משתמש API"

#: classes/class-allpay.php:116
msgid "Crate API Login in your Allpay account: Settings -> Integrations -> WordPress"
msgstr "צור שם משתמש API בחשבון Allpay שלך: הגדרות → אינטגרציות → WordPress"

#: classes/class-allpay.php:119
msgid "API key"
msgstr "מפתח API"

#: classes/class-allpay.php:121
msgid "Crate API key in your Allpay account: Settings -> Integrations -> WordPress"
msgstr "צור מפתח API בחשבון Allpay שלך: הגדרות → אינטגרציות → WordPress"

#: classes/class-allpay.php:124
msgid "Installment max payments"
msgstr "מספר תשלומים מרבי"

#: classes/class-allpay.php:126
msgid "Maximum number of installment payments. Up to 12, zero to disable"
msgstr "מספר תשלומים מרבי. עד 12, 0 לביטול האפשרות"

#: classes/class-allpay.php:127
msgid "Allows client to choose number of payments. Valid for credit cards only (no debit cards)"
msgstr "מאפשר ללקוח לבחור את מספר התשלומים. זמין לכרטיסי אשראי בלבד (לא כרטיסי דביט)"

#: classes/class-allpay.php:131
msgid "Installment min order amount"
msgstr "סכום הזמנה מינימלי לתשלומים"

#: classes/class-allpay.php:133
msgid "Minimum order amount for installments. Zero for orders of any amount"
msgstr "סכום הזמנה מינימלי לתשלומים. 0 להזמנות בכל סכום"

#: classes/class-allpay.php:134
msgid "Enables installment option when payment amount equals or above this value"
msgstr "מאפשר תשלומים כאשר סכום התשלום שווה או גבוה מערך זה"

#: classes/class-allpay.php:138
msgid "Payment currency"
msgstr "מטבע התשלום"

#: classes/class-allpay.php:140
msgid "Before selecting USD or EUR, make sure these currencies are enabled on your Allpay account"
msgstr "לפני בחירת USD או EUR, ודא שמטבעות אלה מופעלים בחשבון Allpay שלך"

#: classes/class-allpay.php:141
msgid "The currency in which the payment will be processed. Any price shown in another currency will be converted to this currency"
msgstr "המטבע שבו התשלום יעובד. כל מחיר המוצג במטבע אחר יומר למטבע זה"

#: classes/class-allpay.php:144
msgid "Israeli Shekel (ILS)"
msgstr "שקל ישראלי (ILS)"

#: classes/class-allpay.php:145
msgid "US Dollar (USD)"
msgstr "דולר אמריקאי (USD)"

#: classes/class-allpay.php:146
msgid "Euro (EUR)"
msgstr "אירו (EUR)"

#: classes/class-allpay.php:150
msgid "Teudat zeut field"
msgstr "שדה תעודת זהות"

#: classes/class-allpay.php:152
#: classes/class-allpay.php:153
msgid "Request Teudat Zehut (Israeli ID) on the payment page"
msgstr "לבקש תעודת זהות (ת״ז) בעמוד התשלום"

#: classes/class-allpay.php:156
msgid "Only for Israeli customers"
msgstr "רק ללקוחות מישראל"

#: classes/class-allpay.php:157
msgid "For all customers"
msgstr "לכל הלקוחות"

#: classes/class-allpay.php:158
msgid "Do not request"
msgstr "לא לבקש"

#: classes/class-allpay.php:272
msgid "We are currently experiencing problems trying to connect to this payment gateway. Sorry for the inconvenience."
msgstr "אנו חווים כעת בעיות בהתחברות לשער התשלומים. עמכם הסליחה על אי הנוחות."

#: classes/class-allpay.php:290
msgid "Unknown error"
msgstr "שגיאה לא ידועה"